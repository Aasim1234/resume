# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on.
PORT=3000

# "production" disables DEMO_AUTO_APPROVE (the server refuses to start with it).
NODE_ENV=development

# Secret key for the admin endpoints (course upload, payment approval).
# Use a long random value, e.g. from:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave empty to disable the admin endpoints.
ADMIN_KEY=

# UPI ID buyers pay to (shown on the page). Leave empty to disable the payment form.
UPI_ID=
UPI_PAYEE_NAME=Hyderabad Trainer
COURSE_PRICE_INR=900

# LOCAL TESTING ONLY: approve every submission without verification.
DEMO_AUTO_APPROVE=false

# Upload limits in MB.
MAX_SCREENSHOT_MB=5
MAX_COURSE_FILE_MB=1024

# Where uploads/, screenshots/ and db.json are stored (default: project folder).
# DATA_DIR=

# Set to true when running behind a reverse proxy / load balancer that terminates HTTPS.
# TRUST_PROXY=false
